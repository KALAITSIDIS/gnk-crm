# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright: keep the specs; the run artifacts AND the module screenshots are report
# output (modules.spec.ts rewrites every PNG on every run; nothing compares them —
# T-repo-hygiene-2026-09-15), so none of it is tracked
/tests/.auth
/tests/.playwright-output
/tests/.playwright-report
/tests/screenshots
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Claude Code per-machine settings (never commit)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# operator photo folders for scripts/import/media.mts - NEVER commit (public repo)
import-media/

# MapLibre worker files copied from node_modules by scripts/copy-maplibre-worker.mjs (predev/prebuild)
public/maplibre/
